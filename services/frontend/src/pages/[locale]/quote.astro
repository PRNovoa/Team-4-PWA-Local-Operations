---
import Page from '../../layouts/Page.astro';
import type { WisdomEntry } from '../../types/domain';

const locale = Astro.params.locale;
if (locale !== 'en' && locale !== 'es') return new Response(null, { status: 404 });
const copy = locale === 'es'
  ? { title: 'Una cita viva', back: 'Inicio', intro: 'Obtenida en directo del corpus gobernado.' }
  : { title: 'A live quote', back: 'Home', intro: 'Fetched live from the governed corpus.' };
const backend = import.meta.env.BACKEND_URL ?? 'http://backend:8000';
const response = await fetch(`${backend}/api/v1/wisdom/sample`, {
  headers: { accept: 'application/json' }
});
if (!response.ok) {
  throw new Error(`Backend quote request failed (${response.status})`);
}
const payload: unknown = await response.json();
if (!Array.isArray(payload) || payload.length === 0) {
  throw new Error('Backend returned no live wisdom entries');
}
const quote: WisdomEntry = payload.find((entry) => entry?.lang === locale) ?? payload[0];
---
<Page lang={locale} title={copy.title}>
  <nav><a href={`/${locale}/`}>{copy.back}</a></nav>
  <main>
    <h1>{copy.title}</h1>
    <p>{copy.intro}</p>
    <article>
      <blockquote>{quote.text}</blockquote>
      <p class="meta">{quote.id} · {quote.section} · {quote.origin} · {quote.lang}</p>
    </article>
    <footer class="meta">
      {quote.rights.holder ?? 'Rubén Vega Balbás'} · {quote.rights.license} ·
      <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>
    </footer>
  </main>
</Page>
